# ── Demo mode (no keys, fictional data) ───────────────────────────────────────
# KATO8_DEMO=1
# VITE_KATO8_DEMO=1
# Ignored automatically when CLERK_SECRET_KEY is set.

# ── Auth (Clerk). Every /api route verifies the session and role; 503 if unset. ──
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── AI assistant. The server picks the model; override only to change tiers. ──
ANTHROPIC_API_KEY=your_api_key_here
# ANTHROPIC_MODEL=

# ── Platforms (all optional; unconnected ones show labelled sample data) ──
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
TWITTER_BEARER_TOKEN=
TWITTER_USERNAME=
INSTAGRAM_USER_TOKEN=
INSTAGRAM_USER_ID=
# INSTAGRAM_GRAPH_VERSION=v23.0   # set to a currently supported Graph API version
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
BLUESKY_HANDLE=

# ── Suite links (optional overrides; defaults live in @kato8/core) ──
# VITE_KATO8_URL_HUB=https://hub.kato8studiosapp.xyz
